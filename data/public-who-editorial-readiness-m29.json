      "kind": "shared_publication_not_equivalent_testimony",
      "personIds": [
        "tim-gallaudet",
        "luis-elizondo",
        "michael-shellenberger",
        "mike-gold"
      ],
      "description": "Four profiles cite one 13 November 2024 hearing transcript. Publishing different testimonies together is not four independent physical corroborations, and Gold's scientific policy recommendation is not an incident.",
      "nextCheck": "Separate each attributed statement from independent original incident data and any programme documentation."
    },
    {
      "id": "nolan-vallee-same-paper",
      "kind": "same_empirical_study_and_parent_sample",
      "personIds": [
        "garry-nolan",
        "jacques-vallee"
      ],
      "description": "Both coauthored one 2022 journal paper, DOI 10.1016/j.paerosci.2021.100788, using the same Council Bluffs CB_JV-1 parent sample. This is ONE lab study, not two independent replications.",
      "nextCheck": "Secure original methods and independent blinded laboratory testing with proven specimen custody."
    },
    {
      "id": "grusch-coverage-shared-sources",
      "kind": "overlapping_reporting_not_separate_physical_proof",
      "personIds": [
        "david-grusch",
        "ross-coulthart",
        "leslie-kean"
      ],
      "description": "Coulthart and Kean reported Grusch-related programme allegations through distinct journalistic work, while Grusch repeated his own account under oath. Outlet and interview counts alone cannot authenticate separate recovered objects or unknown source independence.",
      "nextCheck": "Document each original confidential source's scope and relationship under appropriate confidentiality protections; seek independently inspectable programme and material records."
    },
    {
      "id": "lazar-knapp-reporter-lineage",
      "kind": "shared_historic_interview_reporting",
      "personIds": [
        "bob-lazar",
        "george-knapp"
      ],
      "description": "Lazar's 1989 public S-4 interview was conducted by Knapp, who later described his reporting on that subject. Reprints and the later congressional account draw on one historic source relationship, not necessarily independent employment or technical evidence.",
      "nextCheck": "Authenticate the original broadcast, contemporaneous personnel and access records and any independently testable propulsion evidence."
    },
    {
      "id": "rendlesham-shared-event",
      "kind": "same_historical_event_distinct_account_roles",
      "personIds": [
        "larry-warren",
        "nick-pope"
      ],
      "description": "Warren gives a contested retrospective firsthand account, whereas Pope describes a later cold-case interpretation of the same 1980 Rendlesham reports. Sharing the historical case does not make Pope an additional eyewitness.",
      "nextCheck": "Reconcile exact original 1980–81 duty rosters, Halt documents, separate nights and original participant testimony."
    },
    {
      "id": "nimitz-model-and-sighting",
      "kind": "same_case_distinct_observation_and_model",
      "personIds": [
        "david-fravor",
        "kevin-knuth"
      ],
      "description": "Fravor's firsthand 2004 visual testimony and Knuth's later 2019 acceleration model relate to the Nimitz event, but Knuth's specific rapid-descent timing comes from reported radar observations rather than independent released raw telemetry.",
      "nextCheck": "Retrieve authentic radar timing/tracks and evaluate models separately from pilot visual testimony."
    }
