{
  "version": 1,
  "milestone": "M29",
  "checkedAt": "2026-11-16",
  "state": "public_read_only_editorial_handoff_not_approved",
  "purpose": "Explains which original records, source overlaps and independent checks must be resolved before any claim-specific numerical evidence appraisal. Not an honesty score or UAP truth probability.",
  "rubric": {
    "status": "unweighted_editorial_readiness_checklist_not_a_scoring_formula",
    "numericWeightsApproved": false,
    "independentHumanDecisionRequired": true,
    "dimensions": [
      {
        "key": "claim_scope",
        "label": "Exact claim and firsthand scope",
        "required": "Identify the attributable speaker, date, bounded assertion, firsthand versus relayed elements, and whether an incident metric is meaningful."
      },
      {
        "key": "original_record",
        "label": "Original-source access and provenance",
        "required": "Check the actual original document/video/methods and exact passage; record access denials, edits, custody gaps and source rights without upgrading partial access."
      },
      {
        "key": "source_independence",
        "label": "Source independence and reporting lineage",
        "required": "Separate distinct firsthand witnesses, independent measurements, repeated broadcasts, shared specimen studies, hearing containers and syndicated reporting."
      },
      {
        "key": "competing_records",
        "label": "Contrary sources and alternative interpretations",
        "required": "Inspect the strongest accessible competing original records and accurately record limits; neither silence nor a broad official summary decides a case."
      },
      {
        "key": "measurement_or_documentary_test",
        "label": "Technical replication or documented custody",
        "required": "For incident claims inspect raw calibrated measurements, material custody or programme originals; for policy claims explicitly mark incident scoring not applicable."
      },
      {
        "key": "human_editorial_review",
        "label": "Independent human editorial decision",
        "required": "Record an actual qualified human editor, conflict declaration, signed dated case-specific decision and revisions; never auto-generate signoff."
      },
      {
        "key": "publication_safety",
        "label": "Source rights, privacy and vote-security gate",
        "required": "Confirm public citation rights, original portrait licences, publication approval and separate account-based community vote security before any score or ballot."
      }
    ]
  },
