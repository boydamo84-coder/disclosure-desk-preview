# Local release candidates are generated in CI, never source-controlled
.release-staging/

# Local Supabase CLI version/cache metadata
supabase/.temp/

# Python test caches
__pycache__/
*.pyc

# Generated website and Android review packages
.r3-lab-preview/
android-test/app/src/main/assets/dd-site/
android-test/.gradle/
android-test/.kotlin/
android-test/**/build/
android-test/local.properties

# Never commit Play upload keys or local Android distribution binaries.
*.jks
*.keystore
*.aab
*.apk
